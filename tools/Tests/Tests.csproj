<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(NativeHost)' == 'true'">net10.0</TargetFramework>
    <TargetFramework Condition="'$(NativeHost)' != 'true'">net10.0-windows10.0.22621.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DefineConstants Condition="'$(NativeHost)' == 'true'">$(DefineConstants);NATIVE_HOST</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(HostSource)/VRCFaceTracking.Core/VRCFaceTracking.Core.csproj" />
    <ProjectReference Include="$(HostSource)/VRCFaceTracking.ModuleProcess/VRCFaceTracking.ModuleProcess.csproj" Condition="'$(NativeHost)' == 'true'" />
    <Reference Include="VRCFaceTracking.ModuleProcess" Condition="'$(NativeHost)' != 'true'">
      <HintPath>$(HostModuleProcess)</HintPath>
    </Reference>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.1" />
  </ItemGroup>
</Project>
