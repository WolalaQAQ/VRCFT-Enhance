@@ -0,0 +1,51 @@
+﻿// Copyright 2026 VRCFT-Enhance contributors. Licensed under the Apache License, Version 2.0.
+using System.Globalization;
+
+namespace VRCFaceTracking.Core;
+
+internal static class OscWaitBudgets
+{
+    private const int DefaultMs = 4;
+
+    internal static readonly int PollMs;
+    internal static readonly int OutputMs;
+
+    static OscWaitBudgets()
+    {
+        PollMs = ReadMilliseconds("--osc-poll-ms", "VRCFT_OSC_POLL_MS");
+        OutputMs = ReadMilliseconds("--osc-output-ms", "VRCFT_OSC_OUTPUT_MS");
+    }
+
+    private static int ReadMilliseconds(string option, string environmentName)
+    {
+        var configured = ReadOption(option);
+        var source = "command-line";
+        if (string.IsNullOrEmpty(configured))
+        {
+            configured = Environment.GetEnvironmentVariable(environmentName, EnvironmentVariableTarget.Process);
+            source = "process-environment";
+        }
+        if (string.IsNullOrEmpty(configured))
+            source = "default";
+
+        var milliseconds = string.IsNullOrEmpty(configured) ? DefaultMs : int.Parse(configured, CultureInfo.InvariantCulture);
+        if (milliseconds < 1)
+            throw new ArgumentOutOfRangeException(option, milliseconds, "OSC wait budget must be positive milliseconds.");
+        Console.WriteLine($"OSC wait budget {option}={milliseconds}ms source={source}");
+        return milliseconds;
+    }
+
+    // Accepts "--name=value" and "--name value"; Steam launch options arrive as ordinary process arguments.
+    private static string? ReadOption(string option)
+    {
+        var args = Environment.GetCommandLineArgs();
+        for (var i = 1; i < args.Length; i++)
+        {
+            if (args[i].StartsWith(option + "=", StringComparison.Ordinal))
+                return args[i][(option.Length + 1)..];
+            if (args[i] == option && i + 1 < args.Length)
+                return args[i + 1];
+        }
+        return null;
+    }
+}
