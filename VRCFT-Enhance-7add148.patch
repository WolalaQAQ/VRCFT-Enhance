diff --git b/VRCFaceTracking.Core/TimerResolutionLease.cs b/VRCFaceTracking.Core/TimerResolutionLease.cs
new file mode 100644
index 0000000..4950ad2
--- /dev/null
+++ b/VRCFaceTracking.Core/TimerResolutionLease.cs
@@ -0,0 +1,117 @@
+﻿// Copyright 2026 VRCFT-Enhance contributors. Licensed under the Apache License, Version 2.0.
+using System.Runtime.InteropServices;
+using Microsoft.Extensions.Logging;
+
+namespace VRCFaceTracking.Core;
+
+// One process-local owner. Other power-throttling bits are never owned by this lease.
+internal static class TimerResolutionLease
+{
+    private const int ProcessPowerThrottling = 4;
+    private const uint IgnoreTimerResolution = 4;
+    private static readonly object Sync = new();
+    private static PowerThrottlingState _original;
+    private static bool _started, _policyOwned, _periodOwned;
+    private static ILogger? _logger;
+
+    [StructLayout(LayoutKind.Sequential)]
+    private struct PowerThrottlingState
+    {
+        public uint Version, ControlMask, StateMask;
+    }
+
+    [DllImport("kernel32.dll", SetLastError = true)]
+    [return: MarshalAs(UnmanagedType.Bool)]
+    private static extern bool GetProcessInformation(nint process, int kind,
+        ref PowerThrottlingState information, uint size);
+
+    [DllImport("kernel32.dll", SetLastError = true)]
+    [return: MarshalAs(UnmanagedType.Bool)]
+    private static extern bool SetProcessInformation(nint process, int kind,
+        ref PowerThrottlingState information, uint size);
+
+    internal static void Acquire(ILogger logger)
+    {
+        if (!OperatingSystem.IsWindows()) return;
+        lock (Sync)
+        {
+            if (_started) return;
+            _started = true;
+            _logger = logger;
+            AppDomain.CurrentDomain.ProcessExit += (_, _) => Release();
+
+            _original = new() { Version = 1 };
+            uint size = (uint)Marshal.SizeOf<PowerThrottlingState>();
+            bool gotOriginal = GetProcessInformation(-1, ProcessPowerThrottling, ref _original, size);
+            int getError = gotOriginal ? 0 : Marshal.GetLastPInvokeError();
+            int setError = 0;
+            if (gotOriginal)
+            {
+                var desired = _original;
+                desired.ControlMask |= IgnoreTimerResolution;
+                desired.StateMask &= ~IgnoreTimerResolution;
+                _policyOwned = SetProcessInformation(-1, ProcessPowerThrottling, ref desired, size);
+                setError = _policyOwned ? 0 : Marshal.GetLastPInvokeError();
+            }
+
+            var observed = new PowerThrottlingState { Version = 1 };
+            bool gotObserved = GetProcessInformation(-1, ProcessPowerThrottling, ref observed, size);
+            int observedError = gotObserved ? 0 : Marshal.GetLastPInvokeError();
+            uint beginResult = Utils.TimeBeginPeriod(1);
+            _periodOwned = beginResult == 0;
+
+            logger.LogInformation(
+                $"Timer resolution lease acquire pid={Environment.ProcessId}: GetProcessInformation={gotOriginal} error={getError} before={_original.ControlMask}/{_original.StateMask}; " +
+                $"SetProcessInformation called={gotOriginal} result={_policyOwned} error={setError}; " +
+                $"GetProcessInformation verify={gotObserved} error={observedError} observed={observed.ControlMask}/{observed.StateMask}; " +
+                $"TimeBeginPeriod(1) result={beginResult}.");
+        }
+    }
+
+    internal static void Release()
+    {
+        lock (Sync)
+        {
+            if (!_policyOwned && !_periodOwned) return;
+            bool restoreRequested = _policyOwned;
+            bool gotCurrent = false, restored = false;
+            int getError = 0, setError = 0;
+            var current = new PowerThrottlingState { Version = 1 };
+            var desired = current;
+            uint size = (uint)Marshal.SizeOf<PowerThrottlingState>();
+            if (restoreRequested)
+            {
+                gotCurrent = GetProcessInformation(-1, ProcessPowerThrottling, ref current, size);
+                getError = gotCurrent ? 0 : Marshal.GetLastPInvokeError();
+                if (gotCurrent)
+                {
+                    desired = current;
+                    desired.ControlMask = (current.ControlMask & ~IgnoreTimerResolution) |
+                        (_original.ControlMask & IgnoreTimerResolution);
+                    desired.StateMask = (current.StateMask & ~IgnoreTimerResolution) |
+                        (_original.StateMask & IgnoreTimerResolution);
+                    restored = SetProcessInformation(-1, ProcessPowerThrottling, ref desired, size);
+                    setError = restored ? 0 : Marshal.GetLastPInvokeError();
+                    if (restored) _policyOwned = false;
+                }
+            }
+
+            var observed = new PowerThrottlingState { Version = 1 };
+            bool gotObserved = GetProcessInformation(-1, ProcessPowerThrottling, ref observed, size);
+            int observedError = gotObserved ? 0 : Marshal.GetLastPInvokeError();
+            bool endRequested = _periodOwned;
+            uint endResult = 0;
+            if (endRequested)
+            {
+                endResult = Utils.TimeEndPeriod(1);
+                if (endResult == 0) _periodOwned = false;
+            }
+
+            _logger?.LogInformation(
+                $"Timer resolution lease release pid={Environment.ProcessId}: restoreRequested={restoreRequested} GetProcessInformation={gotCurrent} error={getError} current={current.ControlMask}/{current.StateMask}; " +
+                $"SetProcessInformation called={restoreRequested && gotCurrent} result={restored} error={setError} desired={desired.ControlMask}/{desired.StateMask}; " +
+                $"GetProcessInformation verify={gotObserved} error={observedError} observed={observed.ControlMask}/{observed.StateMask}; " +
+                $"TimeEndPeriod(1) called={endRequested} result={endResult}; policyRestorePending={_policyOwned} periodEndPending={_periodOwned}.");
+        }
+    }
+}
